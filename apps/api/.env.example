# API — copy to .env and fill in

# Database (matches docker-compose default)
DATABASE_URL=postgresql://user:pass@localhost:5432/dentalms

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Storage: s3 (MinIO/AWS) or local (files on server — good for VPS without MinIO)
STORAGE_DRIVER=s3

# When STORAGE_DRIVER=local, files are stored under this directory (create it if missing)
UPLOAD_DIR=./uploads

# Base URL of this API (for local storage file URLs). Use your VPS URL in production.
APP_PUBLIC_URL=http://localhost:3000

# S3-compatible storage (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dental-imaging
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="City Smile Dental <noreply@citysmile.com>"
