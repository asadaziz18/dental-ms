# Web — copy to .env.local for Vite

# API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Socket.IO URL (same as API when served from NestJS)
VITE_SOCKET_URL=http://localhost:3000

# Branch context for API (dev; use JWT branchId when auth is enabled). Use the seeded dev branch UUID.
VITE_BRANCH_ID=00000000-0000-0000-0000-000000000001
